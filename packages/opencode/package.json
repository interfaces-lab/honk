{
  "name": "@honk/opencode",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./host": {
      "types": "./src/host.ts",
      "import": "./src/host.ts"
    },
    "./native": {
      "types": "./src/native.ts",
      "import": "./src/native.ts"
    },
    "./connection-native": {
      "types": "./src/connection-native.ts",
      "import": "./src/connection-native.ts"
    },
    "./hmac": {
      "types": "./src/hmac.ts",
      "import": "./src/hmac.ts"
    },
    "./private-host": {
      "types": "./src/private-host.ts",
      "import": "./src/private-host.ts"
    },
    "./pairing": {
      "types": "./src/host-plugin/pairing.ts",
      "import": "./src/host-plugin/pairing.ts"
    },
    "./agents": {
      "types": "./src/host-plugin/agents.ts",
      "import": "./src/host-plugin/agents.ts"
    }
  },
  "scripts": {
    "check:host-plugin": "node scripts/generate-host-plugin-manifest.mjs --check",
    "check:protocol-boundary": "node scripts/check-protocol-boundary.mjs",
    "generate:host-plugin": "node scripts/generate-host-plugin-manifest.mjs",
    "test": "vitest run",
    "typecheck": "pnpm run check:host-plugin && pnpm run check:protocol-boundary && tsc --noEmit"
  },
  "dependencies": {
    "@opencode-ai/sdk": "1.18.10",
    "react-native-sse": "1.2.1"
  },
  "devDependencies": {
    "@khalilgharbaoui/opencode-claude-code-plugin": "0.12.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
